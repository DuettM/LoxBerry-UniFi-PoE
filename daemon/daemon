#!/bin/bash
# LoxBerry plugin daemon: resolve actual plugin folder, prefer the primary
# unifipoe installation when duplicate suffix installs exist, start MQTT listener,
# return immediately. The listener uses its own flock to prevent duplicates.
set -u
if [ -z "${LBHOMEDIR:-}" ] && [ -r /etc/environment ]; then . /etc/environment; fi
ROOT="${LBHOMEDIR:-${LBHOME:-}}"
if [ -z "$ROOT" ]; then
  HERE="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)"
  ROOT="$(cd "$HERE/../../.." 2>/dev/null && pwd -P)"
fi
DB="$ROOT/data/system/plugindatabase.json"
FOLDER=""
if [ -r "$DB" ]; then
  FOLDER="$(python3 - "$DB" <<'PYDB'
import json,sys
try:
 d=json.load(open(sys.argv[1],encoding='utf-8'))
 matches=[str(p.get('folder','')) for p in d.get('plugins',[]) if p.get('name')=='unifipoe' and p.get('folder')]
 if 'unifipoe' in matches:
  print('unifipoe')
 elif matches:
  print(sorted(matches)[0])
except Exception:
 pass
PYDB
)"
fi
if [ -z "$FOLDER" ] && [ -r "$ROOT/data/system/plugindatabase.dat" ]; then
  FOLDER="$(awk -F'|' '$5=="unifipoe" && $6=="unifipoe" {print $6; exit} $5=="unifipoe" && first=="" {first=$6} END{if(first!="") print first}' "$ROOT/data/system/plugindatabase.dat" | head -n1)"
fi
[ -n "$FOLDER" ] || FOLDER="unifipoe"
BIN="$ROOT/bin/plugins/$FOLDER"
CFG="$ROOT/config/plugins/$FOLDER/config.json"
LOG="$ROOT/log/plugins/$FOLDER/mqtt-daemon.log"
[ -x "$BIN/mqtt_listener.py" ] && [ -r "$CFG" ] || exit 0
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
if [ "$(id -u)" -eq 0 ] && id loxberry >/dev/null 2>&1; then
  runuser -u loxberry -- sh -c 'exec "$1" --config "$2" --core "$3" >>"$4" 2>&1' _ "$BIN/mqtt_listener.py" "$CFG" "$BIN/unifipoe.py" "$LOG" &
else
  "$BIN/mqtt_listener.py" --config "$CFG" --core "$BIN/unifipoe.py" >>"$LOG" 2>&1 &
fi
exit 0
