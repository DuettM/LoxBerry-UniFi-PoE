#!/usr/bin/perl
use strict;
use warnings;
use CGI;
use JSON::PP;
use LoxBerry::System;
use LoxBerry::Web;
use File::Basename qw(basename);
use Digest::SHA qw(hmac_sha256_hex);

my $cfgfile = "$lbpconfigdir/config.json";
my $cgi = CGI->new;
my $initial_page = $cgi->param('page') // 'overview';
my %valid_pages = map { $_ => 1 } qw(overview ports groups loxone settings diagnostics debug);
$initial_page = 'overview' unless $valid_pages{$initial_page};
sub esc { my $s=shift//''; $s=~s/&/&amp;/g; $s=~s/</&lt;/g; $s=~s/>/&gt;/g; $s=~s/"/&quot;/g; return $s; }
sub readcfg {
    open my $fh,'<',$cfgfile or die "Config fehlt";
    local $/; my $raw=<$fh>; close $fh;
    return decode_json($raw);
}
my $c=readcfg();
$c->{mqtt}||={}; $c->{watchdog}||={}; $c->{debug}||={}; $c->{aliases}||={}; $c->{groups}||=[];
my $aliases = esc(JSON::PP->new->canonical->pretty->encode($c->{aliases}));
my $groups = esc(JSON::PP->new->canonical->pretty->encode($c->{groups}));
my $groups_js = encode_json($c->{groups});
my $token_js = encode_json($c->{api_token}//'CHANGE_ME');
my $page_js = encode_json($initial_page);
my $plugin_folder = basename($lbpconfigdir);
my $public_api_js = encode_json('/plugins/'.$plugin_folder.'/poe.cgi');
my $csrf_seed = ($ENV{HTTP_COOKIE}//'').'|'.($ENV{HTTP_USER_AGENT}//'');
my $csrf_js = encode_json(hmac_sha256_hex($csrf_seed, ($c->{api_token}//'')));

LoxBerry::Web::lbheader('UniFi PoE Control','https://www.loxberry.de','', 'nojqm');
print <<'CSS';
<style>
:root{--green:#73b72b;--green-dark:#4d8e1a;--green-soft:#f0f7e9;--text:#252d35;--muted:#71808d;--line:#dde4e8;--bg:#f6f8f9;--red:#d94343;--orange:#ee9c24;--blue:#2f7fc7;--purple:#8c63c7}
*{box-sizing:border-box}.up-root{max-width:1580px;margin:0 auto;padding:12px 12px 26px;color:var(--text);font-family:Arial,Helvetica,sans-serif}.up-head{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--line);border-radius:9px;padding:13px 16px;margin-bottom:12px}.up-logo{width:58px;height:58px;border-radius:8px;background:linear-gradient(145deg,#86ca42,#5ba21d);display:grid;place-items:center;box-shadow:0 2px 8px #00000012;flex:0 0 auto}.up-logo svg{width:40px;height:40px}.up-title{flex:1}.up-title h1{margin:0 0 4px;color:#257c31;font-size:24px}.up-title p{margin:0;color:#56616b}.head-state{display:flex;align-items:center;gap:8px;color:#4a555d;font-size:13px}.dot{width:10px;height:10px;border-radius:50%;background:#aaa;display:inline-block}.dot.ok{background:#36a344}.dot.bad{background:#d84444}
.app{display:grid;grid-template-columns:220px minmax(0,1fr);gap:12px}.nav{background:#fff;border:1px solid var(--line);border-radius:9px;padding:8px;height:max-content;position:sticky;top:8px}.nav a{width:100%;display:flex;gap:10px;align-items:center;border:0;background:transparent;padding:11px 12px;border-radius:6px;text-align:left;color:#34404a;font-weight:600;cursor:pointer;text-decoration:none}.nav a:hover{background:#f5f8f3}.nav a.active{background:#eaf5df;color:#2d7d29}.nav .sep{height:1px;background:#edf0f2;margin:7px 4px}.nav small{display:block;color:#8a959e;padding:8px 12px 4px;font-size:10px;text-transform:uppercase;letter-spacing:.07em}.content{min-width:0}.page{display:none}.page.active{display:block}.card{background:#fff;border:1px solid var(--line);border-radius:9px;margin-bottom:12px;box-shadow:0 1px 3px #00000008}.card h2{font-size:17px;margin:0;padding:13px 15px;border-bottom:1px solid #edf0f2}.body{padding:15px}.metrics{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:10px;margin-bottom:12px}.metric{background:#fff;border:1px solid var(--line);border-radius:9px;padding:14px;display:flex;align-items:center;gap:12px;min-height:92px}.mic{width:50px;height:50px;border-radius:7px;display:grid;place-items:center;color:#fff;font-size:26px;flex:0 0 auto}.metric b{display:block;font-size:23px}.metric small{color:var(--muted)}.grid2{display:grid;grid-template-columns:minmax(0,2fr) minmax(310px,.9fr);gap:12px}.grid-eq{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.btn{border:1px solid #cdd6dc;background:#fff;border-radius:6px;padding:9px 12px;cursor:pointer;font-weight:600;color:#2f3942}.btn:hover{background:#f5f7f8}.btn-green{background:var(--green);border-color:var(--green);color:#fff}.btn-red{border-color:#f1b3b3;color:var(--red)}.btn-orange{border-color:#f0cc99;color:#b9720b}.btn-blue{border-color:#a8c8e8;color:var(--blue)}.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}.toolbar input,.toolbar select{height:38px;border:1px solid #cbd4da;border-radius:6px;padding:0 10px;background:#fff}.toolbar input.search{flex:1;min-width:180px}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:9px 7px;border-bottom:1px solid #e9edef;text-align:left}th{background:#fafbfb}.port-scroll{overflow:auto;max-height:440px;border:1px solid #edf0f2;border-radius:7px;scrollbar-gutter:stable}.port-scroll.full{max-height:calc(100vh - 285px);min-height:420px}.port-scroll table{margin:0}.port-scroll thead th{position:sticky;top:0;z-index:3;background:#fafbfb;box-shadow:0 1px 0 #e2e7ea}.port-count{font-size:12px;color:var(--muted);white-space:nowrap}.pill{display:inline-block;padding:3px 8px;border-radius:5px;border:1px solid #cbe1c1;background:#f0f8ec;color:#23802a;font-size:12px}.pill.off{background:#f2f3f4;border-color:#d7dadd;color:#626b72}.rowbtn{width:35px;height:31px;padding:0;margin-right:3px}.ok{color:#278c2b}.bad{color:#cf3838}.warn{color:#b87410}.muted{color:var(--muted)}.kv{display:grid;grid-template-columns:1fr auto;gap:8px 18px;font-size:13px}.testline{display:grid;grid-template-columns:18px 1fr;gap:8px;padding:6px 0}.testline .mark{font-weight:bold}.action-stack{display:grid;gap:8px}.action-stack .btn{width:100%}.group-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #edf0f2}.group-row:last-child{border:0}.group-actions{display:flex;gap:5px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(250px,1fr));gap:12px}.field label{display:block;font-weight:700;font-size:12px;margin:3px 0 5px}.field input,.field select,.field textarea{width:100%;border:1px solid #cbd4da;border-radius:6px;padding:9px;background:#fff}.field textarea{min-height:135px;font-family:Consolas,monospace;font-size:12px}.hint{font-size:11px;color:var(--muted);margin-top:4px}.checks{display:flex;gap:18px;flex-wrap:wrap;margin:14px 0}.settings-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.save-state{font-size:13px}.notice{padding:10px 12px;border-radius:6px;margin-bottom:12px;display:none}.notice.okmsg{display:block;background:#edf8e8;border:1px solid #cbe5bd;color:#34751f}.notice.errmsg{display:block;background:#fff0f0;border:1px solid #efc0c0;color:#a52828}.mono{font-family:Consolas,monospace;background:#f6f7f8;border:1px solid #e1e5e8;border-radius:5px;padding:9px;font-size:11px;word-break:break-all}.debug-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px}.debugbox{height:360px;overflow:auto;border:1px solid #e1e5e8;background:#fbfbfb;font-family:Consolas,monospace;font-size:12px}.logrow{display:grid;grid-template-columns:165px 75px 1fr;padding:6px 8px;border-bottom:1px solid #edf0f2}.lvl{font-weight:bold}.lvl-debug{color:#31823d}.lvl-info{color:#2d71b4}.lvl-warning{color:#9f6a11}.lvl-error{color:#c53434}.footer{text-align:center;color:#4a545c;padding:16px 0 0;font-size:14px}.mobile-nav{display:none;margin-bottom:10px}.mobile-nav select{width:100%;height:42px;border:1px solid var(--line);border-radius:7px;padding:0 10px;background:#fff}@media(max-width:760px){.port-scroll,.port-scroll.full{max-height:58vh;min-height:280px}}
@media(max-width:1150px){.metrics{grid-template-columns:repeat(3,1fr)}.grid2{grid-template-columns:1fr}}@media(max-width:820px){.app{grid-template-columns:1fr}.nav{display:none}.mobile-nav{display:block}.metrics{grid-template-columns:repeat(2,1fr)}.form-grid,.grid-eq{grid-template-columns:1fr}}@media(max-width:520px){.metrics{grid-template-columns:1fr}.up-head{align-items:flex-start;flex-wrap:wrap}.head-state{width:100%}.logrow{grid-template-columns:1fr}.metric{min-height:72px}}
</style>
CSS

if ($initial_page ne 'overview') {
    print '<style>#page-overview{display:none!important}#page-' . esc($initial_page) . '{display:block!important}.nav [data-page="overview"]{background:transparent;color:#34404a}.nav [data-page="' . esc($initial_page) . '"]{background:#eaf5df;color:#2d7d29}</style>';
}
print '<div class="up-root">';
print <<'HEAD';
<div class="up-head">
 <div class="up-logo"><svg viewBox="0 0 64 64" aria-label="UniFi PoE"><rect x="9" y="10" width="46" height="32" rx="5" fill="none" stroke="white" stroke-width="4"/><path d="M16 19h6v10h-6m9-10h6v10h-6m9-10h6v10h-6m9-10h6v10h-6" stroke="white" stroke-width="3" fill="none"/><path d="M35 39l-9 13h8l-3 10 14-17h-9l4-6z" fill="white"/></svg></div>
 <div class="up-title"><h1>UniFi PoE Control</h1><p>PoE direkt vom LoxBerry schalten und überwachen</p></div>
 <div class="head-state"><i id="head-dot" class="dot"></i><span id="head-status">UniFi wird geprüft …</span></div>
</div>
HEAD
print <<'NAV';
<div class="mobile-nav"><select id="mobile-page" onchange="location.href='index.cgi?page='+encodeURIComponent(this.value)"><option value="overview">Übersicht</option><option value="ports">PoE-Ports</option><option value="groups">Gruppen</option><option value="loxone">Loxone / MQTT Generator</option><option value="settings">Einstellungen</option><option value="diagnostics">Diagnose</option><option value="debug">Debug-Log</option></select></div>
<div class="app">
 <nav class="nav">
  <small>UniFi PoE</small>
  <a class="active" data-page="overview" href="index.cgi?page=overview">⌂ Übersicht</a>
  <a data-page="ports" href="index.cgi?page=ports">▣ PoE-Ports</a>
  <a data-page="groups" href="index.cgi?page=groups">◫ Gruppen</a>
  <a data-page="loxone" href="index.cgi?page=loxone">↔ Loxone Generator</a>
  <div class="sep"></div>
  <a data-page="settings" href="index.cgi?page=settings">⚙ Einstellungen</a>
  <a data-page="diagnostics" href="index.cgi?page=diagnostics">◉ Diagnose</a>
  <a data-page="debug" href="index.cgi?page=debug">▤ Debug-Log</a>
 </nav>
 <div class="content">
NAV

print <<'OVERVIEW';
<section id="page-overview" class="page active">
 <div class="metrics">
  <div class="metric"><div class="mic" style="background:#2e9a3b">⌘</div><div><b id="m-switches">–</b>Switches<br><small id="m-switches-sub">Noch nicht geladen</small></div></div>
  <div class="metric"><div class="mic" style="background:#2d7fc8">▣</div><div><b id="m-ports">–</b>PoE-Ports<br><small id="m-ports-sub">Noch nicht geladen</small></div></div>
  <div class="metric"><div class="mic" style="background:#eda029">⚡</div><div><b id="m-power">–</b>Gesamt PoE<br><small>Aktueller Verbrauch</small></div></div>
  <div class="metric"><div class="mic" style="background:#8e61cb">∿</div><div><b id="m-system">…</b>System<br><small id="m-system-sub">Selbsttest ausstehend</small></div></div>
  <div class="metric"><div class="mic" style="background:#2c7bc1">✓</div><div><b id="m-watchdog">…</b>Watchdog<br><small id="m-watchdog-sub">Status wird geladen</small></div></div>
 </div>
 <div class="grid2">
  <div class="card"><h2>▣ PoE-Ports – Schnellübersicht</h2><div class="body"><div class="toolbar"><select id="switch-select-overview" onchange="syncSwitch(this.value);renderQuickPorts()"><option>Lade Switches …</option></select><span id="overview-port-count" class="port-count"></span><button class="btn" onclick="loadDevices()">↻ Aktualisieren</button><button class="btn btn-blue" onclick="showPage('ports')">Alle Ports</button></div><div class="port-scroll"><table><thead><tr><th>Port</th><th>Name</th><th>PoE</th><th>Leistung</th><th>Link</th><th>Aktionen</th></tr></thead><tbody id="quick-ports"><tr><td colspan="6">Lade Daten …</td></tr></tbody></table></div></div></div>
  <div>
   <div class="card"><h2>⚡ Schnellaktionen</h2><div class="body action-stack"><button class="btn btn-green" onclick="allPorts('on')">Alle PoE-Ports EIN</button><button class="btn btn-red" onclick="allPorts('off')">Alle PoE-Ports AUS</button><button class="btn btn-orange" onclick="allPorts('cycle')">Alle Ports neu starten</button></div></div>
   <div class="card"><h2>◉ Systemstatus</h2><div class="body"><div class="kv"><div>UniFi Controller</div><div id="sys-unifi">–</div><div>MQTT</div><div id="sys-mqtt">–</div><div>Watchdog</div><div id="sys-watchdog">–</div><div>Plugin</div><div class="ok">0.7.5</div></div></div></div>
  </div>
 </div>
</section>
OVERVIEW

print <<'PORTS';
<section id="page-ports" class="page">
 <div class="card"><h2>▣ PoE-Ports</h2><div class="body">
  <div class="toolbar"><select id="switch-select" onchange="syncSwitch(this.value);renderPorts()"><option>Lade Switches …</option></select><span><i id="switch-dot" class="dot"></i> <span id="switch-state">Offline</span></span><span id="ports-count" class="port-count"></span><input id="filter" class="search" placeholder="Port, Name oder Gerät suchen …" oninput="renderPorts()"><button class="btn" onclick="loadDevices()">↻ Aktualisieren</button></div>
  <div class="port-scroll full"><table><thead><tr><th>Port</th><th>Name</th><th>UniFi-Name</th><th>PoE</th><th>Spannung</th><th>Leistung</th><th>Link</th><th>Aktionen</th></tr></thead><tbody id="ports-body"><tr><td colspan="8">Lade Daten …</td></tr></tbody></table></div>
 </div></div>
</section>
PORTS

print <<'GROUPS';
<section id="page-groups" class="page">
 <div class="card"><h2>◫ PoE-Gruppen</h2><div class="body"><p class="muted" style="margin-top:0">Mehrere Ports gemeinsam schalten, zum Beispiel Access Points, Kameras oder Telefone.</p><div id="groups-list">Noch keine Gruppen geladen.</div><div style="margin-top:12px"><button class="btn btn-blue" onclick="showPage('settings');document.getElementById('groups_json').scrollIntoView({behavior:'smooth'})">Gruppen bearbeiten</button></div></div></div>
</section>
GROUPS

print '<section id="page-settings" class="page"><div id="settings-message" class="notice"></div><div class="card"><h2>⚙ UniFi-Verbindung</h2><div class="body"><form id="settings-form" method="post" action="config.cgi" onsubmit="if(window.saveSettings){saveSettings(event);return false}"><input type="hidden" name="action" value="save"><input type="hidden" name="native" value="1"><input type="hidden" name="csrf" value="'.esc(hmac_sha256_hex($csrf_seed, ($c->{api_token}//''))).'"><div class="form-grid">';
print '<div class="field"><label>UDM / UniFi Controller IP oder URL</label><input name="controller" id="controller" value="'.esc($c->{controller}//'').'" placeholder="192.168.1.1 oder https://192.168.1.1"><div class="hint">Bei reiner IP wird automatisch HTTPS verwendet.</div></div>';
print '<div class="field"><label>Controller-Typ</label><select name="controller_type" id="controller_type"><option value="unifios"'.(($c->{controller_type}//'unifios') eq 'unifios'?' selected':'').'>UniFi OS / UDM / CloudKey</option><option value="classic"'.(($c->{controller_type}//'') eq 'classic'?' selected':'').'>Classic Network Controller</option></select></div>';
print '<div class="field"><label>Benutzername</label><input name="username" id="username" value="'.esc($c->{username}//'').'" autocomplete="username"></div>';
print '<div class="field"><label>Passwort</label><input type="password" name="password" id="password" value="" autocomplete="current-password" placeholder="Leer = gespeichertes Passwort beibehalten"><div class="hint">Das gespeicherte Passwort wird nicht an den Browser zurückgegeben.</div></div>';
print '<div class="field"><label>Site</label><input name="site" value="'.esc($c->{site}//'default').'" placeholder="default"></div>';
print '<div class="field"><label>PoE-Neustartdauer</label><input type="number" min="1" max="60" name="cycle_seconds" value="'.esc($c->{cycle_seconds}//5).'"><div class="hint">Sekunden zwischen AUS und EIN beim Power-Cycle.</div></div>';
print '<div class="field"><label>Loxone API-Token</label><div style="display:flex;gap:6px"><input name="api_token" id="api_token" value="'.esc($c->{api_token}//'CHANGE_ME').'"><button class="btn" type="button" onclick="newToken()">Neu</button><button class="btn" type="button" onclick="copyToken()">Kopieren</button></div><div class="hint">Schützt die HTTP-Schnittstelle für Loxone. Nach „Neu“ bitte Einstellungen speichern.</div></div>';
print '<div class="field"><label>Debug-Level</label><select name="debug_level">';
for my $v (qw(debug info warning error)){ print '<option value="'.$v.'"'.(($c->{debug}{level}//'info') eq $v?' selected':'').'>'.$v.'</option>'; }
print '</select></div></div><div class="checks"><label><input type="checkbox" name="verify_ssl" value="1"'.($c->{verify_ssl}?' checked':'').'> TLS-Zertifikat prüfen</label><label><input type="checkbox" name="watchdog_enabled" value="1"'.($c->{watchdog}{enabled}?' checked':'').'> Watchdog aktiv</label></div><div class="settings-actions"><button type="button" class="btn btn-blue" onclick="testConnection()">Verbindung testen</button><button type="submit" class="btn btn-green">Einstellungen speichern</button><span id="settings-state" class="save-state muted"></span></div></div></div>';
print '<div class="card"><h2>MQTT / Loxone</h2><div class="body"><div class="notice okmsg" style="display:block;margin-bottom:12px"><b>LoxBerry MQTT Gateway</b><br>Broker-Adresse, Port, Benutzer und Passwort werden automatisch aus der LoxBerry-Systemkonfiguration übernommen. Im UniFi-PoE-Plugin müssen keine MQTT-Zugangsdaten mehr gepflegt werden.</div><div class="form-grid">';
print '<div class="field"><label>MQTT Topic</label><input id="mqtt_base_topic" name="mqtt_base_topic" value="'.esc($c->{mqtt}{base_topic}//'unifipoe').'" placeholder="unifipoe"><div class="hint">Standard: <b>unifipoe</b>. Frei änderbar, z. B. haus/unifipoe.</div></div>';
print '<div class="field"><label>Broker</label><input value="LoxBerry MQTT Gateway (automatisch)" disabled><div class="hint">Wird aus $LBHOME/config/system/general.json → Mqtt gelesen.</div></div>';
print '<div class="field"><label>MQTT Command-Token</label><div style="display:flex;gap:6px"><input id="mqtt_command_token" name="mqtt_command_token" value="'.esc($c->{mqtt}{command_token}//'').'"><button class="btn" type="button" onclick="newMqttToken()">Neu</button><button class="btn" type="button" onclick="copyMqttToken()">Kopieren</button></div><div class="hint">Optionaler Zusatzschutz. Normalerweise genügt die Anmeldung am LoxBerry MQTT Broker mit Benutzername und Passwort.</div></div></div><div class="checks"><label><input type="checkbox" name="mqtt_enabled" value="1"'.($c->{mqtt}{enabled}?' checked':'').'> MQTT aktiv</label><label><input type="checkbox" name="mqtt_listen_enabled" value="1"'.(($c->{mqtt}{listen_enabled}//1)?' checked':'').'> MQTT-Befehle empfangen</label><label><input type="checkbox" name="mqtt_retain" value="1"'.($c->{mqtt}{retain}?' checked':'').'> Status retained</label><label><input type="checkbox" name="mqtt_command_token_required" value="1"'.(($c->{mqtt}{command_token_required}//0)?' checked':'').'> Zusätzlichen MQTT Command-Token verwenden</label></div><div class="hint" style="margin-top:8px">Befehle: &lt;Topic&gt;/set/port/&lt;SWITCH_ID&gt;/&lt;PORT&gt; mit ON, OFF, CYCLE oder STATUS. Gruppen: &lt;Topic&gt;/set/group/&lt;GRUPPE&gt;.</div></div></div>';
print '<div class="card"><h2>Portnamen &amp; Gruppen</h2><div class="body"><div class="form-grid"><div class="field"><label>Port-Aliase (JSON)</label><textarea name="aliases_json" id="aliases_json">'.$aliases.'</textarea><div class="hint">Format: {"SWITCH_ID:PORT":"Kamera Einfahrt"}</div></div><div class="field"><label>Gruppen (JSON)</label><textarea name="groups_json" id="groups_json">'.$groups.'</textarea><div class="hint">Gruppen werden auf der Seite „Gruppen“ angezeigt.</div></div></div><div style="margin-top:12px"><button type="submit" class="btn btn-green">Alles speichern</button></div></form></div></div></section>';

print <<'LOXONE';
<section id="page-loxone" class="page">
 <div class="card"><h2>↔ Loxone Befehls-Generator</h2><div class="body">
  <p class="muted" style="margin-top:0">Switch, Port und Aktion auswählen. Das Plugin erzeugt wahlweise HTTP oder MQTT für Loxone.</p>
  <div class="form-grid">
   <div class="field"><label>Schnittstelle</label><select id="gen-mode" onchange="buildLoxoneUrl()"><option value="http">HTTP</option><option value="mqtt">MQTT</option></select></div>
   <div class="field"><label>Switch</label><select id="gen-switch" onchange="renderGeneratorPorts();buildLoxoneUrl()"><option>Lade Switches …</option></select></div>
   <div class="field"><label>Port</label><select id="gen-port" onchange="buildLoxoneUrl()"><option>–</option></select></div>
   <div class="field"><label>Aktion</label><select id="gen-action" onchange="buildLoxoneUrl()"><option value="on">PoE EIN</option><option value="off">PoE AUS</option><option value="cycle">PoE Neustart</option><option value="status">Status lesen</option></select></div>
   <div class="field"><label>API-Token</label><input id="gen-token" value="" oninput="buildLoxoneUrl()"><div class="hint">Wird beim Laden aus den Plugin-Einstellungen übernommen.</div></div>
  </div>
  <div style="margin-top:14px"><label id="gen-output-label" style="font-weight:700">Fertige URL</label><div id="gen-url" class="mono" style="margin-top:6px;word-break:break-all">Daten werden geladen …</div></div><div id="gen-payload-wrap" style="margin-top:10px;display:none"><label style="font-weight:700">Payload</label><div id="gen-payload" class="mono" style="margin-top:6px">–</div></div>
  <div class="settings-actions"><button class="btn btn-green" onclick="copyLoxoneUrl()">Befehl kopieren</button><button class="btn btn-blue" onclick="testGeneratedUrl()">Befehl testen</button><span id="gen-state" class="muted"></span></div>
  <div class="notice okmsg" style="display:block;margin-top:16px">HTTP nutzt POST-Body oder Header statt Token in der URL. MQTT nutzt die Zugangsdaten des LoxBerry Brokers; ein zusätzlicher Command-Token ist optional. Automatisch das LoxBerry MQTT Gateway und den frei wählbaren Topic-Präfix; der MQTT-Listener läuft als LoxBerry-Daemon.</div>
 </div></div>
 <div class="card"><h2>API-Endpunkte</h2><div class="body"><div class="kv"><div>PoE EIN</div><div class="mono">cmd=on</div><div>PoE AUS</div><div class="mono">cmd=off</div><div>Neustart</div><div class="mono">cmd=cycle</div><div>Status</div><div class="mono">cmd=status</div><div>Gruppe EIN/AUS</div><div class="mono">cmd=group-on / group-off</div></div></div></div>
</section>
LOXONE

print <<'DIAG';
<section id="page-diagnostics" class="page">
 <div class="grid-eq">
  <div class="card"><h2>◉ Selbsttest</h2><div class="body" id="selftest"><span class="muted">Noch kein Test ausgeführt.</span></div><div class="body"><button class="btn btn-blue" onclick="runSelftest()">Selbsttest starten</button></div></div>
  <div class="card"><h2>⌁ Watchdog</h2><div class="body"><div class="kv"><div>Status</div><div id="wd-ok">–</div><div>Letzte erfolgreiche Prüfung</div><div id="wd-last">–</div><div>Antwortzeit</div><div id="wd-ms">–</div><div>Fehlerfolge</div><div id="wd-fails">–</div><div>Switches</div><div id="wd-switches">–</div><div>PoE-Ports</div><div id="wd-ports">–</div></div></div></div>
 </div>
 <div class="card"><h2>HTTP-Schnittstelle für Loxone</h2><div class="body"><p class="muted">Beispiel für den aktuell ausgewählten Switch:</p><div id="api-example" class="mono">Daten werden geladen …</div></div></div>
</section>
<section id="page-debug" class="page"><div class="card"><h2>▤ Debug-Log</h2><div class="body"><div class="debug-controls"><select id="log-lines" onchange="loadLog()"><option>50</option><option selected>100</option><option>250</option><option>500</option></select><button class="btn" onclick="loadLog()">↻ Aktualisieren</button><button class="btn btn-red" onclick="clearLog()">Log leeren</button><label style="margin-left:auto"><input type="checkbox" id="auto-log" checked> Auto-Refresh</label></div><div id="debugbox" class="debugbox"></div></div></div></section>
DIAG

print '<div class="footer">Project contributors &nbsp;·&nbsp; 2026</div></div></div></div>';

print qq~<script>
const API='api.cgi'; const CSRF=$csrf_js; const PUBLIC_API=$public_api_js; const TOKEN=$token_js; const INITIAL_PAGE=$page_js; let GROUPS=$groups_js; let DEVICES=[]; let CURRENT=0;
function h(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function showPage(name){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));let p=document.getElementById('page-'+name);if(p)p.classList.add('active');document.querySelectorAll('.nav [data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page===name));let m=document.getElementById('mobile-page');if(m)m.value=name;if(name==='debug')loadLog();if(name==='diagnostics'){loadWatchdog();}}
function syncSwitch(v){CURRENT=Math.max(0,parseInt(v||0));['switch-select','switch-select-overview'].forEach(id=>{let e=document.getElementById(id);if(e&&e.options.length)e.value=String(CURRENT)});renderQuickPorts();renderPorts();}
async function jsonFetch(url,opts={}){let hdr=new Headers(opts.headers||{});if((opts.method||'GET').toUpperCase()==='POST')hdr.set('X-UniFi-CSRF',CSRF);let r=await fetch(url,{cache:'no-store',...opts,headers:hdr}),t=await r.text(),ct=(r.headers.get('content-type')||'').toLowerCase();let j;try{j=JSON.parse(t)}catch(e){if(t.trim().toLowerCase().startsWith('<!doctype')||t.toLowerCase().includes('<html'))throw new Error('Interner Plugin-Endpunkt lieferte HTML statt JSON (HTTP '+r.status+'). Bitte Debug-Log prüfen.');throw new Error('Ungültige Plugin-Antwort (HTTP '+r.status+', '+ct+'): '+t.slice(0,160))}if(!r.ok&&!j.error)j.error='HTTP '+r.status;return j}
async function call(q,mutate=false){if(mutate)return jsonFetch(API,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:q});return jsonFetch(API+'?'+q)}
async function loadDevices(){try{let j=await call('cmd=devices');if(!j.ok)throw new Error(j.error||'UniFi API Fehler');DEVICES=j.devices||[];for(const id of ['switch-select','switch-select-overview']){let s=document.getElementById(id);s.innerHTML=DEVICES.length?DEVICES.map((d,i)=>'<option value="'+i+'">'+h(d.name||d.mac||d.id)+'</option>').join(''):'<option>Keine Switches gefunden</option>';s.value=String(Math.min(CURRENT,Math.max(0,DEVICES.length-1)))}CURRENT=Math.min(CURRENT,Math.max(0,DEVICES.length-1));let ports=DEVICES.reduce((n,d)=>n+(d.ports||[]).length,0),power=DEVICES.reduce((n,d)=>n+(d.ports||[]).reduce((a,p)=>a+(parseFloat(p.poe_power)||0),0),0);document.getElementById('m-switches').textContent=DEVICES.length;document.getElementById('m-switches-sub').textContent='Online: '+DEVICES.length;document.getElementById('m-ports').textContent=ports;document.getElementById('m-ports-sub').textContent='Erkannt: '+ports;document.getElementById('m-power').textContent=power.toFixed(1)+' W';document.getElementById('head-dot').className='dot ok';document.getElementById('head-status').textContent='UniFi verbunden';document.getElementById('switch-dot').className='dot ok';document.getElementById('switch-state').textContent='Online';document.getElementById('sys-unifi').innerHTML='<span class="ok">Verbunden</span>';renderQuickPorts();renderPorts();renderGroups();renderGeneratorSwitches();}catch(e){document.getElementById('head-dot').className='dot bad';document.getElementById('head-status').textContent='UniFi Fehler';document.getElementById('switch-dot').className='dot bad';document.getElementById('switch-state').textContent='Fehler';document.getElementById('sys-unifi').innerHTML='<span class="bad">Fehler</span>';document.getElementById('ports-body').innerHTML='<tr><td colspan="8" class="bad">'+h(e.message)+'</td></tr>';document.getElementById('quick-ports').innerHTML='<tr><td colspan="6" class="bad">'+h(e.message)+'</td></tr>'}}
function rowHtml(d,p,quick){let on=(p.poe_mode||'auto')!=='off',alias=p.alias||p.name||('Port '+p.port_idx),w=on?(parseFloat(p.poe_power)||0):0,v=on?(p.poe_voltage??'–'):0;let sw=encodeURIComponent(d.id||'');let acts='<button class="btn rowbtn btn-green" title="Ein" data-sw="'+sw+'" data-port="'+p.port_idx+'" onclick="portAction(decodeURIComponent(this.dataset.sw),Number(this.dataset.port),&quot;on&quot;)">⏻</button><button class="btn rowbtn btn-orange" title="Neustart" data-sw="'+sw+'" data-port="'+p.port_idx+'" onclick="portAction(decodeURIComponent(this.dataset.sw),Number(this.dataset.port),&quot;cycle&quot;)">↻</button><button class="btn rowbtn btn-red" title="Aus" data-sw="'+sw+'" data-port="'+p.port_idx+'" onclick="portAction(decodeURIComponent(this.dataset.sw),Number(this.dataset.port),&quot;off&quot;)">■</button>';if(quick)return '<tr><td>'+p.port_idx+'</td><td>'+h(alias)+'</td><td><span class="pill '+(on?'':'off')+'">'+(on?'Ein':'Aus')+'</span></td><td>'+w.toFixed(1)+' W</td><td class="'+(p.link_up?'ok':'muted')+'">'+(p.link_up?'Online':'–')+'</td><td>'+acts+'</td></tr>';return '<tr><td>'+p.port_idx+'</td><td>'+h(alias)+'</td><td>'+h(p.name||'–')+'</td><td><span class="pill '+(on?'':'off')+'">'+(on?'Ein':'Aus')+'</span></td><td>'+h(v)+' V</td><td>'+w.toFixed(1)+' W</td><td class="'+(p.link_up?'ok':'muted')+'">'+(p.link_up?'Online':'–')+'</td><td>'+acts+'</td></tr>'}
function renderQuickPorts(){let d=DEVICES[CURRENT],b=document.getElementById('quick-ports'),c=document.getElementById('overview-port-count');if(!d){b.innerHTML='<tr><td colspan="6">Keine Daten.</td></tr>';if(c)c.textContent='';return}let rows=d.ports||[];if(c)c.textContent=rows.length+' PoE-Port'+(rows.length===1?'':'s');b.innerHTML=rows.map(p=>rowHtml(d,p,true)).join('')||'<tr><td colspan="6">Keine PoE-Ports erkannt.</td></tr>';updateApiExample(d)}
function renderPorts(){let d=DEVICES[CURRENT],b=document.getElementById('ports-body'),c=document.getElementById('ports-count');if(!d){b.innerHTML='<tr><td colspan="8">Keine Daten.</td></tr>';if(c)c.textContent='';return}let all=d.ports||[],f=(document.getElementById('filter').value||'').toLowerCase(),rows=all.filter(p=>JSON.stringify(p).toLowerCase().includes(f));if(c)c.textContent=f?(rows.length+' / '+all.length+' Ports'):all.length+' PoE-Port'+(all.length===1?'':'s');b.innerHTML=rows.map(p=>rowHtml(d,p,false)).join('')||'<tr><td colspan="8">Keine passenden Ports.</td></tr>';updateApiExample(d)}
function updateApiExample(d){if(!d)return;document.getElementById('api-example').textContent=location.origin+PUBLIC_API+'\\nPOST: token='+TOKEN+'&cmd=off&switch='+encodeURIComponent(d.id)+'&port=1'}
async function portAction(sw,p,cmd){try{let j=await call('cmd='+cmd+'&switch='+encodeURIComponent(sw)+'&port='+p,true);if(!j.ok)throw new Error(j.error||'Schaltfehler');for(const d of DEVICES){if((d.id||'')===sw){let x=(d.ports||[]).find(q=>Number(q.port_idx)===Number(p));if(x){if(cmd==='off'){x.poe_mode='off';x.poe_power=0;x.poe_current=0;x.poe_voltage=0}else if(cmd==='on'){x.poe_mode='auto'}}}}renderQuickPorts();renderPorts();setTimeout(loadDevices,cmd==='cycle'?1500:1200)}catch(e){alert(e.message)}}
async function allPorts(cmd){let d=DEVICES[CURRENT];if(!d)return;if(!confirm('Alle PoE-Ports von '+(d.name||d.mac)+' wirklich '+cmd+'?'))return;for(const p of d.ports||[]){try{await call('cmd='+cmd+'&switch='+encodeURIComponent(d.id)+'&port='+p.port_idx,true)}catch(e){}}loadDevices()}
function renderGroups(){let el=document.getElementById('groups-list');el.innerHTML=GROUPS.length?GROUPS.map(g=>{let gn=encodeURIComponent(g.name||'');return '<div class="group-row"><div><b>'+h(g.name)+'</b><div class="muted" style="font-size:12px">'+(g.ports||[]).length+' Port(s)</div></div><div class="group-actions"><button class="btn btn-green" data-g="'+gn+'" onclick="groupAction(this.dataset.g,&quot;group-on&quot;)">EIN</button><button class="btn btn-orange" data-g="'+gn+'" onclick="groupAction(this.dataset.g,&quot;group-cycle&quot;)">↻</button><button class="btn btn-red" data-g="'+gn+'" onclick="groupAction(this.dataset.g,&quot;group-off&quot;)">AUS</button></div></div>'}).join(''):'<span class="muted">Noch keine Gruppen angelegt.</span>'}
async function groupAction(g,cmd){try{let j=await call('cmd='+cmd+'&group='+g,true);if(!j.ok)throw new Error(j.error||'Gruppenfehler');loadDevices()}catch(e){alert(e.message)}}
function formData(action){let form=document.getElementById('settings-form'),fd=new FormData(form);fd.set('action',action);fd.set('native','0');for(const id of ['controller','username','password']){let el=document.getElementById(id);if(el)fd.set(id,el.value||'')}for(const n of ['verify_ssl','watchdog_enabled','mqtt_enabled','mqtt_listen_enabled','mqtt_retain','mqtt_command_token_required'])if(!fd.has(n))fd.set(n,'0');let q=new URLSearchParams();for(const [k,v] of fd.entries())q.append(k,String(v));return q.toString()}
function settingsMsg(ok,text){let n=document.getElementById('settings-message');n.className='notice '+(ok?'okmsg':'errmsg');n.textContent=text;n.scrollIntoView({behavior:'smooth',block:'nearest'})}
async function saveSettings(ev){ev.preventDefault();let s=document.getElementById('settings-state');s.textContent='Speichere …';try{let j=await jsonFetch('config.cgi',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:formData('save')});if(!j.ok)throw new Error(j.error||'Speichern fehlgeschlagen');settingsMsg(true,j.message||'Gespeichert.');s.textContent='Gespeichert';document.getElementById('password').value='';setTimeout(()=>location.reload(),700)}catch(e){settingsMsg(false,e.message);s.textContent='Fehler'}}
async function testConnection(){let s=document.getElementById('settings-state');s.textContent='Teste Verbindung …';try{let j=await jsonFetch('config.cgi',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:formData('test')});if(!j.ok)throw new Error(j.error||'Verbindung fehlgeschlagen');settingsMsg(true,j.message);s.textContent='Verbindung OK'}catch(e){settingsMsg(false,e.message);s.textContent='Test fehlgeschlagen'}}
function newToken(){let a=new Uint8Array(32);crypto.getRandomValues(a);let t=Array.from(a,b=>b.toString(16).padStart(2,'0')).join('');document.getElementById('api_token').value=t;let g=document.getElementById('gen-token');if(g)g.value=t;buildLoxoneUrl()}
async function copyText(v){try{await navigator.clipboard.writeText(v);return true}catch(e){let x=document.createElement('textarea');x.value=v;document.body.appendChild(x);x.select();let ok=document.execCommand('copy');x.remove();return ok}}
async function copyToken(){let t=document.getElementById('api_token').value;if(await copyText(t)){let s=document.getElementById('settings-state');s.textContent='Token kopiert';setTimeout(()=>s.textContent='',1800)}}
function newMqttToken(){let a=new Uint8Array(32);crypto.getRandomValues(a);document.getElementById('mqtt_command_token').value=Array.from(a,b=>b.toString(16).padStart(2,'0')).join('');buildLoxoneUrl()}
async function copyMqttToken(){let t=document.getElementById('mqtt_command_token').value;if(await copyText(t)){let s=document.getElementById('settings-state');s.textContent='MQTT-Token kopiert';setTimeout(()=>s.textContent='',1800)}}
function renderGeneratorSwitches(){let s=document.getElementById('gen-switch');if(!s)return;s.innerHTML=DEVICES.length?DEVICES.map((d,i)=>'<option value="'+i+'">'+h(d.name||d.mac||d.id)+'</option>').join(''):'<option value="">Keine Switches</option>';s.value=String(Math.min(CURRENT,Math.max(0,DEVICES.length-1)));let t=document.getElementById('gen-token');if(t&&!t.value)t.value=TOKEN;renderGeneratorPorts();buildLoxoneUrl()}
function renderGeneratorPorts(){let si=parseInt(document.getElementById('gen-switch')?.value||'0'),d=DEVICES[si],p=document.getElementById('gen-port');if(!p)return;p.innerHTML=d&&(d.ports||[]).length?(d.ports||[]).map(x=>'<option value="'+x.port_idx+'">Port '+x.port_idx+' – '+h(x.alias||x.name||'')+'</option>').join(''):'<option value="">Keine PoE-Ports</option>'}
function resolvedMqttBase(){let b=(document.getElementById('mqtt_base_topic')?.value||'unifipoe').trim();while(b.startsWith('/'))b=b.slice(1);while(b.endsWith('/'))b=b.slice(0,-1);return b||'unifipoe'}
function buildLoxoneUrl(){let si=parseInt(document.getElementById('gen-switch')?.value||'0'),d=DEVICES[si],p=document.getElementById('gen-port')?.value,a=document.getElementById('gen-action')?.value||'status',t=document.getElementById('gen-token')?.value||TOKEN,out=document.getElementById('gen-url'),mode=document.getElementById('gen-mode')?.value||'http',pw=document.getElementById('gen-payload-wrap'),pl=document.getElementById('gen-payload'),lab=document.getElementById('gen-output-label');if(!out)return;if(!d||!p){out.textContent='Bitte Switch und Port wählen.';return}if(mode==='mqtt'){let mt=document.getElementById('mqtt_command_token')?.value||'';out.textContent=resolvedMqttBase()+'/set/port/'+d.id+'/'+p;let req=document.querySelector('[name=\"mqtt_command_token_required\"]')?.checked;pl.textContent=req?JSON.stringify({token:mt,action:a.toUpperCase()}):a.toUpperCase();pw.style.display='block';lab.textContent='MQTT Topic'}else{out.textContent=location.origin+PUBLIC_API;pl.textContent='token='+encodeURIComponent(t)+'&cmd='+encodeURIComponent(a)+'&switch='+encodeURIComponent(d.id)+'&port='+encodeURIComponent(p);pw.style.display='block';lab.textContent='HTTP POST URL'}}
async function copyLoxoneUrl(){let mode=document.getElementById('gen-mode')?.value||'http',v=document.getElementById('gen-url').textContent+'\\nPayload: '+document.getElementById('gen-payload').textContent,s=document.getElementById('gen-state');if(await copyText(v)){s.textContent=mode==='mqtt'?'Topic + Payload kopiert':'URL kopiert';setTimeout(()=>s.textContent='',1800)}}
async function testGeneratedUrl(){let si=parseInt(document.getElementById('gen-switch')?.value||'0'),d=DEVICES[si],p=document.getElementById('gen-port')?.value,a=document.getElementById('gen-action')?.value||'status',s=document.getElementById('gen-state');if(!d||!p)return;s.textContent='Teste …';try{let j=await call('cmd='+encodeURIComponent(a)+'&switch='+encodeURIComponent(d.id)+'&port='+encodeURIComponent(p),a!=='status');if(!j.ok)throw new Error(j.error||'Fehler');s.textContent='OK'}catch(e){s.textContent='Fehler: '+e.message}}

let SELFTEST_CHECKED=false;
function renderSelftestResult(j){let el=document.getElementById('selftest');if(!j||!j.timestamp){el.innerHTML='<span class="muted">Noch kein Test ausgeführt.</span>';return}el.innerHTML='<div style="font-weight:bold;margin-bottom:7px" class="'+(j.ok?'ok':'bad')+'">'+(j.ok?'Alle Prüfungen erfolgreich':'Fehler gefunden')+'</div>'+(j.tests||[]).map(t=>'<div class="testline"><span class="mark '+(t.ok?'ok':'bad')+'">●</span><div><b>'+h(t.name)+'</b><div class="muted" style="font-size:11px">'+h(t.detail||'')+'</div></div></div>').join('');document.getElementById('m-system').textContent=j.ok?'OK':'FEHLER';document.getElementById('m-system-sub').textContent=(j.ok?'Alles in Ordnung':'Fehler: '+(j.summary?.failed||0))+' · '+new Date(j.timestamp*1000).toLocaleTimeString();let mt=(j.tests||[]).find(x=>x.name==='MQTT Verbindung');if(mt){let off=String(mt.detail||'').toLowerCase().includes('deaktiviert');document.getElementById('sys-mqtt').innerHTML=off?'<span class="muted">Deaktiviert</span>':(mt.ok?'<span class="ok">Aktiv · Verbunden</span>':'<span class="bad">Aktiv · Verbindung fehlgeschlagen</span>')}}
async function runSelftest(openPage=true){let el=document.getElementById('selftest');el.innerHTML='Prüfung läuft …';if(openPage)showPage('diagnostics');try{let j=await call('cmd=selftest');renderSelftestResult(j);return j}catch(e){el.innerHTML='<span class="bad">'+h(e.message)+'</span>';document.getElementById('m-system').textContent='FEHLER';document.getElementById('m-system-sub').textContent=e.message;return null}}
async function loadSelftestStatus(){if(SELFTEST_CHECKED)return;SELFTEST_CHECKED=true;try{let j=await jsonFetch('debug.cgi?action=selftest'),st=j.selftest||{},age=st.timestamp?Math.floor(Date.now()/1000)-Number(st.timestamp):999999;if(j.exists&&st.timestamp){renderSelftestResult(st)}if(!j.exists||!st.timestamp||age>21600){await runSelftest(false)}}catch(e){document.getElementById('m-system').textContent='FEHLER';document.getElementById('m-system-sub').textContent='Selbstteststatus nicht lesbar'}}
let WATCHDOG_KICKED=false;
async function loadWatchdog(){try{let j=await jsonFetch('debug.cgi?action=watchdog'),w=j.watchdog||{},enabled=!!j.enabled,exists=!!j.exists;if(!enabled){document.getElementById('wd-ok').innerHTML='<span class="muted">Deaktiviert</span>';for(const id of ['wd-last','wd-ms','wd-fails','wd-switches','wd-ports'])document.getElementById(id).textContent='–';document.getElementById('m-watchdog').textContent='AUS';document.getElementById('m-watchdog-sub').textContent='Deaktiviert';document.getElementById('sys-watchdog').innerHTML='<span class="muted">Deaktiviert</span>';return}if(!exists||!w.timestamp){document.getElementById('wd-ok').innerHTML='<span class="warn">Ausstehend</span>';document.getElementById('m-watchdog').textContent='START';document.getElementById('m-watchdog-sub').textContent='Warte auf erste Prüfung';document.getElementById('sys-watchdog').innerHTML='<span class="warn">Wartet</span>';if(!WATCHDOG_KICKED){WATCHDOG_KICKED=true;try{await jsonFetch('debug.cgi?action=watchdog_run');setTimeout(loadWatchdog,2500)}catch(e){}}return}let age=Math.floor(Date.now()/1000)-Number(w.timestamp||0),stale=age>180;document.getElementById('wd-ok').innerHTML=w.ok&&!stale?'<span class="ok">OK</span>':(stale?'<span class="warn">Veraltet</span>':'<span class="bad">Fehler</span>');document.getElementById('wd-last').textContent=w.last_success?new Date(w.last_success*1000).toLocaleString():'–';document.getElementById('wd-ms').textContent=(w.response_ms??'–')+' ms';document.getElementById('wd-fails').textContent=w.consecutive_failures??'–';document.getElementById('wd-switches').textContent=w.switches??'–';document.getElementById('wd-ports').textContent=w.ports??'–';document.getElementById('m-watchdog').textContent=w.ok&&!stale?'OK':(stale?'ALT':'FEHLER');document.getElementById('m-watchdog-sub').textContent=(stale?'Status veraltet · ':'Letzte Prüfung: ')+new Date(w.timestamp*1000).toLocaleTimeString();document.getElementById('sys-watchdog').innerHTML=w.ok&&!stale?'<span class="ok">Aktiv · OK</span>':(stale?'<span class="warn">Aktiv · Status veraltet</span>':'<span class="bad">Aktiv · Fehler</span>')}catch(e){document.getElementById('m-watchdog').textContent='FEHLER';document.getElementById('m-watchdog-sub').textContent='Status nicht lesbar';document.getElementById('sys-watchdog').innerHTML='<span class="bad">Fehler</span>'}}
async function loadLog(){try{let n=document.getElementById('log-lines').value,j=await jsonFetch('debug.cgi?action=read&lines='+n),box=document.getElementById('debugbox');box.innerHTML=(j.lines||[]).reverse().map(line=>{let m=line.match(/^(\\S+ \\S+) \\[(\\w+)\\] (.*)/);if(!m)return '<div class="logrow"><span></span><span></span><span>'+h(line)+'</span></div>';let l=m[2].toLowerCase();return '<div class="logrow"><span>'+h(m[1])+'</span><span class="lvl lvl-'+l+'">'+h(m[2])+'</span><span>'+h(m[3])+'</span></div>'}).join('')||'<div style="padding:12px" class="muted">Noch keine Logeinträge.</div>'}catch(e){}}
async function clearLog(){if(!confirm('Debug-Log wirklich leeren?'))return;await fetch('debug.cgi?action=clear',{cache:'no-store'});loadLog()}
renderGroups();let mp=document.getElementById('mobile-page');if(mp)mp.value=INITIAL_PAGE;document.querySelectorAll('.nav [data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page===INITIAL_PAGE));let gt=document.getElementById('gen-token');if(gt)gt.value=TOKEN;async function initHealth(){await loadDevices();await loadSelftestStatus();await loadWatchdog()}initHealth();setInterval(loadWatchdog,30000);setInterval(()=>{if(!document.hidden)loadDevices()},30000);setInterval(()=>{if(document.getElementById('auto-log')?.checked)loadLog()},5000);
</script>~;
LoxBerry::Web::lbfooter();
