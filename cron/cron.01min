#!/bin/bash
# LoxBerry cron wrapper. Resolve actual plugin folder from PluginDB and prefer
# the primary unifipoe installation if duplicate suffix installs exist.
set -u
if [ -z "${LBHOMEDIR:-}" ] && [ -r /etc/environment ]; then . /etc/environment; fi
ROOT="${LBHOMEDIR:-${LBHOME:-}}"
if [ -z "$ROOT" ]; then
  HERE="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)"
  ROOT="$(cd "$HERE/../../.." 2>/dev/null && pwd -P)"
fi
DB="$ROOT/data/system/plugindatabase.json"
FOLDER=""
if [ -r "$DB" ]; then
  FOLDER="$(python3 - "$DB" <<'PYDB'
import json,sys
try:
 d=json.load(open(sys.argv[1],encoding='utf-8'))
 matches=[str(p.get('folder','')) for p in d.get('plugins',[]) if p.get('name')=='unifipoe' and p.get('folder')]
 if 'unifipoe' in matches:
  print('unifipoe')
 elif matches:
  print(sorted(matches)[0])
except Exception:
 pass
PYDB
)"
fi
if [ -z "$FOLDER" ] && [ -r "$ROOT/data/system/plugindatabase.dat" ]; then
  FOLDER="$(awk -F'|' '$5=="unifipoe" && $6=="unifipoe" {print $6; exit} $5=="unifipoe" && first=="" {first=$6} END{if(first!="") print first}' "$ROOT/data/system/plugindatabase.dat" | head -n1)"
fi
[ -n "$FOLDER" ] || FOLDER="unifipoe"
WD="$ROOT/bin/plugins/$FOLDER/watchdog.py"
CFG="$ROOT/config/plugins/$FOLDER/config.json"
[ -x "$WD" ] && [ -r "$CFG" ] || exit 0
"$WD" "$CFG" >/dev/null 2>&1
exit 0
